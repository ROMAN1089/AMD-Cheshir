AMD_API_KEY=
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_VISION_MODEL=
AMD_CHAT_MODEL=
AMD_INTENT_MODEL=
SELLER_PASSWORD=
LOCAL_ACCESS=true
DATA_DIR=./data
HOST=127.0.0.1
PORT=5000
BACKEND_URL=http://127.0.0.1:5000
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://127.0.0.1:3000
ASR_MODEL_PATH=

# Free Sandbox setup: docs/EBAY_SETUP.ru.md. Keep credentials server-side.
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
# Optional: OAuth refresh token from the Developer Portal's User Tokens flow.
# Leave empty when connecting through the app's OAuth redirect.
EBAY_REFRESH_TOKEN=
# Never enable this for a zero-budget demo: real listing fees can apply.
EBAY_ENABLE_PRODUCTION=false

# Optional READ-ONLY US research source; uses separate Production application keys.
# Disabled by default. No listing publication or purchase is performed by Browse.
EBAY_BROWSE_ENABLED=false
EBAY_BROWSE_CLIENT_ID=
EBAY_BROWSE_CLIENT_SECRET=

# Encrypted Cloudflare Pages/Workers inbox for account deletion notifications.
# Setup: deploy/ebay-notifications/README.ru.md. Private RSA key stays in private/.
EBAY_NOTIFICATION_RELAY=
EBAY_NOTIFICATION_POLL_TOKEN=

# Google Calendar: Web application OAuth client. Keep the JSON outside public/Git.
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google-calendar/callback
